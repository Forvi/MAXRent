# Приложение
APP_ENV=dev
# Таймаут graceful shutdown
APP_SHUTDOWN_TIMEOUT=15s
# Накатывать миграции при старте. На проде с несколькими репликами выключают.
APP_AUTO_MIGRATE=true

# Логирование: dev — цветной текст, prod — JSON
APP_LOG_LEVEL=DEBUG

# База данных
DB_URL=postgres://maxrent:maxrent@localhost:5432/maxrent?sslmode=disable
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=1h
DB_CONN_MAX_IDLE_TIME=5m
DB_PING_TIMEOUT=5s
# Каталог миграций. В контейнере задаётся через Dockerfile.
DB_MIGRATION_PATH=./migrations

# Бот MAX
BOT_TOKEN=
# Таймаут HTTP-запроса к API MAX
BOT_REQUEST_TIMEOUT=10s
# Таймаут long polling: сколько ждать апдейтов перед пустым ответом
BOT_POLLING_TIMEOUT=30s
# Пауза между запросами апдейтов
BOT_POLLING_PAUSE=500ms
# Пауза перед повтором запроса после сетевой ошибки
BOT_ERROR_RETRY_PAUSE=5s
# Адрес API. Пусто — использовать адрес MAX по умолчанию.
BOT_BASE_URL=
