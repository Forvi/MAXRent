# Приложение
APP_ENV=dev
# Интервал опроса апдейтов бота (long polling)
APP_POLLING_INTERVAL=5s
# Таймаут graceful shutdown
APP_SHUTDOWN_TIMEOUT=15s

# Логирование: dev — цветной текст, prod — JSON
APP_LOG_LEVEL=DEBUG

# База данных
DB_URL=postgres://maxrent:maxrent@localhost:5432/maxrent?sslmode=disable
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=1h
DB_CONN_MAX_IDLE_TIME=5m
DB_PING_TIMEOUT=5s

# Миграции
MIGRATION_PATH=./migrations

# Токен бота (заполнить при интеграции с мессенджером)
# BOT_TOKEN=
